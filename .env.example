# Copy to .env and fill in. .env is git-ignored — never commit real values.

# --- Domain -------------------------------------------------------------
# ":80"           local Docker or behind Coolify's proxy (plain HTTP inside)
# "cmgi-apps.de"  on a VPS with DNS pointing here: automatic HTTPS via Let's Encrypt
CMGI_SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# --- EventPass ------------------------------------------------------------
# Required. At least 12 characters. Generate one e.g. with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
EVENTPASS_ADMIN_PASSWORD=
EVENTPASS_TIMEZONE=Europe/Berlin
# Only needed if a frontend on ANOTHER origin calls the API (comma-separated). Same-origin needs nothing.
EVENTPASS_ORIGIN=
# Public address used for links in emails, e.g. https://cmgi-apps.de (optional, otherwise taken from the request).
EVENTPASS_PUBLIC_URL=
# Badge email after registration (optional; without SMTP host + sender nothing is sent).
# Brevo (free 300/day): smtp-relay.brevo.com, port 587, starttls, SMTP login + key from the Brevo dashboard.
# Gmail / Google Workspace: smtp.gmail.com, port 587, starttls, address + 16-character app password.
EVENTPASS_SMTP_HOST=
EVENTPASS_SMTP_PORT=587
EVENTPASS_SMTP_SECURITY=starttls
EVENTPASS_SMTP_USER=
EVENTPASS_SMTP_PASSWORD=
EVENTPASS_MAIL_FROM=CMGI EventPass <events@example.org>
EVENTPASS_MAIL_REPLY_TO=

# --- Sermon Intelligence ---------------------------------------------------
# Required. Separate password from EventPass, at least 12 characters.
SERMON_ADMIN_PASSWORD=
# Speech-to-text (https://platform.openai.com/api-keys) — about $0.36 per hour of audio
OPENAI_API_KEY=
# Reports & translations (https://console.anthropic.com/) — roughly $0.30 per language per hour of sermon
ANTHROPIC_API_KEY=
SERMON_CLAUDE_MODEL=claude-opus-5-5
SERMON_TRANSCRIBE_MODEL=whisper-1

# --- Central database (PostgreSQL) -------------------------------------------
# Admin password of the central database server. Required. Each app gets its own database
# and login (see infrastructure/database/setup.sh); apps never use this admin login.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- CMGI Accounts (central login for all apps) --------------------------------
# Password of the accounts service in the central database. Required.
ACCOUNTS_DB_PASSWORD=
# Shared secret between app backends and the accounts service (credit bookings). Required, >= 24 characters.
ACCOUNTS_INTERNAL_KEY=
# Platform admins (admin console at /admin), comma-separated. Set in config only, not in the database.
CMGI_ADMIN_EMAILS=
# Public address for links in emails, e.g. https://cmgi-apps.de
CMGI_PUBLIC_URL=
# True once the site runs on https:// (login cookie only over HTTPS).
CMGI_SECURE_COOKIES=false
# Sender of account emails (confirmation, password reset). Default: EVENTPASS_MAIL_FROM.
CMGI_MAIL_FROM=

# --- Body of Christ (separate repo carls12/bodyofchrist-django, docs/DEPLOYMENT.md) ---
# Switched off until the image exists. To enable: COMPOSE_PROFILES=bodyofchrist
COMPOSE_PROFILES=
# Image version (release tag from the bodyofchrist-django repo). Empty = the version pinned in compose.yaml.
BODYOFCHRIST_VERSION=
# Required when enabled. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"            (secret key, DB password)
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep TOTP_ENCRYPTION_KEY in a password manager: if it changes, every 2FA setup is lost.
BODYOFCHRIST_SECRET_KEY=
BODYOFCHRIST_TOTP_ENCRYPTION_KEY=
# Password of its own login in the central database (database "bodyofchrist").
BODYOFCHRIST_DB_PASSWORD=
# Public domain(s), comma-separated, plus localhost for the health check.
BODYOFCHRIST_ALLOWED_HOSTS=localhost,127.0.0.1
# Once the site runs on https://: True and https://cmgi-apps.de
BODYOFCHRIST_SECURE_COOKIES=False
BODYOFCHRIST_CSRF_TRUSTED_ORIGINS=
BODYOFCHRIST_SUPER_ADMIN_EMAIL=
BODYOFCHRIST_SUPER_ADMIN_EMAILS=
BODYOFCHRIST_GOOGLE_CLIENT_ID=
BODYOFCHRIST_GOOGLE_CLIENT_SECRET=
# Email uses the EventPass SMTP settings above unless these are set.
BODYOFCHRIST_EMAIL_HOST=
BODYOFCHRIST_MAIL_FROM=

# --- Portal (public, compiled into the website) -----------------------------
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=
VITE_ORGANISATION_NAME=CMGI

# --- Backups (host scripts in infrastructure/deployment) ----------------------
BACKUP_DEST=/var/backups/cmgi-apps
BACKUP_KEEP_DAYS=30
