# Copy to .env and fill in. .env is git-ignored — never commit real values.

# --- Domain -------------------------------------------------------------
# ":80"           local Docker or behind Coolify's proxy (plain HTTP inside)
# "cmgi-apps.de"  on a VPS with DNS pointing here: automatic HTTPS via Let's Encrypt
CMGI_SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# --- EventPass ------------------------------------------------------------
# Required. At least 12 characters. Generate one e.g. with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
EVENTPASS_ADMIN_PASSWORD=
EVENTPASS_TIMEZONE=Europe/Berlin
# Only needed if a frontend on ANOTHER origin calls the API (comma-separated). Same-origin needs nothing.
EVENTPASS_ORIGIN=
# Public address used for links in emails, e.g. https://cmgi-apps.de (optional, otherwise taken from the request).
EVENTPASS_PUBLIC_URL=
# Badge email after registration (optional; without SMTP host + sender nothing is sent).
# Brevo (free 300/day): smtp-relay.brevo.com, port 587, starttls, SMTP login + key from the Brevo dashboard.
# Gmail / Google Workspace: smtp.gmail.com, port 587, starttls, address + 16-character app password.
EVENTPASS_SMTP_HOST=
EVENTPASS_SMTP_PORT=587
EVENTPASS_SMTP_SECURITY=starttls
EVENTPASS_SMTP_USER=
EVENTPASS_SMTP_PASSWORD=
EVENTPASS_MAIL_FROM=CMGI EventPass <events@example.org>
EVENTPASS_MAIL_REPLY_TO=

# --- Sermon Intelligence ---------------------------------------------------
# Required. Separate password from EventPass, at least 12 characters.
SERMON_ADMIN_PASSWORD=
# Speech-to-text (https://platform.openai.com/api-keys) — about $0.36 per hour of audio
OPENAI_API_KEY=
# Reports & translations (https://console.anthropic.com/) — roughly $0.30 per language per hour of sermon
ANTHROPIC_API_KEY=
SERMON_CLAUDE_MODEL=claude-opus-5-5
SERMON_TRANSCRIBE_MODEL=whisper-1

# --- Portal (public, compiled into the website) -----------------------------
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=
VITE_ORGANISATION_NAME=CMGI

# --- Backups (host scripts in infrastructure/deployment) ----------------------
BACKUP_DEST=/var/backups/cmgi-apps
BACKUP_KEEP_DAYS=30
